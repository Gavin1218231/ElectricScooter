PORT=3001

# REQUIRED for production. Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left unset, the server generates a random per-process secret at startup
# (sessions won't survive a restart). Never reuse this placeholder value.
JWT_SECRET=

# Comma-separated list of allowed browser origins for CORS.
# Defaults to http://localhost:3000 when unset.
CORS_ORIGIN=http://localhost:3000

DB_PATH=./data/vim.db
