PORT=3001

# REQUIRED. The server refuses to start without this unless NODE_ENV is
# explicitly 'development' or 'test' (npm run dev sets development for you).
# Generate a strong random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Do not reuse this placeholder, and never commit the real value.
JWT_SECRET=

# Comma-separated list of allowed browser origins for CORS.
# Defaults to http://localhost:3000 when unset.
CORS_ORIGIN=http://localhost:3000

# Only set this when running behind a reverse proxy (nginx, ELB, Cloudflare).
# Value is the number of trusted proxy hops (e.g. 1) or a CIDR/IP.
# Without it, rate limiting keys every client behind the proxy into one bucket.
# Never set it to `true` — that trusts a fully client-controlled header and
# lets anyone bypass rate limiting with a forged X-Forwarded-For.
# TRUST_PROXY=1

DB_PATH=./data/vim.db
